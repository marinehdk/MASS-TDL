# 船舶实时位姿（GNC → 航线规划）
std_msgs/Header header

# ============================================================
# 地理位置（WGS84）
# ============================================================
float64 latitude           # 纬度（度，正北为正）
float64 longitude          # 经度（度，正东为正）

# ============================================================
# 姿态
# ============================================================
float64 heading_deg        # 艏向角：真北顺时针（度）[船头朝向，0~360]
float64 course_deg         # 航迹向 COG：真北顺时针（度）[实际运动方向，0~360]
                           # heading != course 时说明有横流/横风
float64 roll_deg           # 横摇角（度，右舷下沉为正，来自4DOF动力学/odom）
float64 roll_rate_rads     # 横摇角速度（rad/s）
float64 roll_rate_deg_s    # 横摇角速度（度/s）
bool    roll_limit_exceeded # true = abs(roll_deg) 超过当前仿真保护阈值

# ============================================================
# 速度 —— 船体坐标系（Body Frame）
# ============================================================
float64 surge_mps          # 纵向速度（m/s，向前为正）
float64 sway_mps           # 横向速度（m/s，向右为正）
float64 speed_mps          # 合速度（m/s）= sqrt(surge²+sway²)

# ============================================================
# 速度 —— 地理坐标系（Geographic Frame）
# ============================================================
float64 vel_north_mps      # 向北速度分量（m/s）
float64 vel_east_mps       # 向东速度分量（m/s）

# ============================================================
# 角速度
# ============================================================
float64 yaw_rate_rads      # 艏摇角速度（rad/s，右转为正）
float64 yaw_rate_deg_s     # 艏摇角速度（度/s，右转为正）

# ============================================================
# 局部 NED 坐标（调试用，相对坐标原点的平面距离）
# ============================================================
float64 x_ned              # 北向位移（m，相对出发点原点）
float64 y_ned              # 东向位移（m，相对出发点原点）

# ============================================================
# 航线横偏（相对航线规划模块原始 RoutePlan 折线）
# ============================================================
float64 cross_track_error_m      # 有符号 XTE（m）：正值=航线右侧/右舷侧，负值=航线左侧/左舷侧
float64 cross_track_error_abs_m  # XTE 绝对值（m）
int32   cross_track_segment_idx  # 最近航段起点索引；-1 = 当前无有效航线

# ============================================================
# 导航状态
# ============================================================
int32   nav_state          # 当前导航阶段：
                           #   0 = 未初始化（未收到航线）
                           #   1 = ILOS 精确跟踪模式
                           #   2 = HOMING 大偏差切入模式
                           #   3 = 终点 DP 保持模式
string  nav_state_str      # 可读文字版，如 "ILOS" / "HOMING" / "DP_HOLD"

# ============================================================
# 坐标系原点信息
# ============================================================
bool    origin_locked      # true = 原点已锁定（位置有效）
float64 origin_lat         # 原点纬度（度）
float64 origin_lon         # 原点经度（度）
