<?xml version="1.0"?>
<package format="3">
  <name>ais_twin</name>
  <version>0.1.0</version>
  <description>AIS digital-twin capture and replay for MASS-L3 SIL</description>
  <maintainer email="team-e3@mass-l3-tdl.local">Team-E3</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-websockets</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geographic_msgs</exec_depend>
  <exec_depend>l3_external_msgs</exec_depend>
  <exec_depend>l3_msgs</exec_depend>

  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
