# MASS L3 TDL — Dev Docker 镜像（开发者本地容器）
# 详见: docs/Implementation/ci-cd-pipeline.md §4.1
# D1.2 revision: 从 Jazzy 切 Humble，对齐 Dockerfile.ci
# 镜像: mass-l3/dev:humble-ubuntu22.04
# 构建命令: docker build --build-arg-file tools/docker/version-lock.txt -f tools/docker/Dockerfile.dev .
ARG ROS_BASE_DIGEST
FROM ros:humble-ros-base@${ROS_BASE_DIGEST}

ARG GCC_12_VER
ARG CLANG_TIDY_14_VER
ARG CMAKE_VER
ARG CPPCHECK_VER
ARG EIGEN3_VER
ARG GEOGRAPHICLIB_VER
ARG BOOST_DEV_VER
ARG NLOHMANN_JSON_VER

# System tools and compilers (与 Dockerfile.ci 同基线)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gcc-12=${GCC_12_VER} g++-12=${GCC_12_VER} \
        clang-14=${CLANG_TIDY_14_VER} lld-14=${CLANG_TIDY_14_VER} \
        clang-tidy-14=${CLANG_TIDY_14_VER} clang-format-14=${CLANG_TIDY_14_VER} \
        cmake=${CMAKE_VER} \
        ninja-build \
        ccache \
        git curl wget \
        python3-dev python3-pip python3-venv \
        lcov gcovr \
        valgrind \
        cppcheck=${CPPCHECK_VER} \
        jq \
        yamllint \
        libeigen3-dev=${EIGEN3_VER} \
        libgeographiclib-dev=${GEOGRAPHICLIB_VER} \
        libboost-dev=${BOOST_DEV_VER} \
        nlohmann-json3-dev=${NLOHMANN_JSON_VER} \
    && rm -rf /var/lib/apt/lists/*

# ===== Dev 专属工具（Dockerfile.ci 不含）=====
RUN apt-get update && apt-get install -y --no-install-recommends \
        gdb \
        lldb-14 \
        strace ltrace \
        tmux htop \
        vim nano \
        less \
        man-db \
        bash-completion \
        sudo \
    && rm -rf /var/lib/apt/lists/*

# Python tools (与 Dockerfile.ci 一致)
RUN pip3 install --no-cache-dir --break-system-packages --ignore-installed \
        colcon-core==0.20.1 \
        colcon-common-extensions \
        ruff==0.6.9 \
        mypy==1.10.1 \
        pytest==8.3.3 \
        pytest-cov==5.0.0 \
        ipython \
        ipdb

# Set GCC 12 as default
RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 100 && \
    update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-12 100 && \
    update-alternatives --install /usr/bin/clang clang /usr/bin/clang-14 100 && \
    update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-14 100

# Source ROS2 environment by default in interactive shells
RUN echo "source /opt/ros/humble/setup.bash" >> /etc/bash.bashrc

WORKDIR /workspace